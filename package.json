{
  "name": "dom-x",
  "version": "1.2.0",
  "description": "Browser perception & change-intelligence MCP server for AI browser agents. Replaces expensive screenshot polling with structured DOM events and bounding box action tags.",
  "type": "module",
  "main": "dist/content.js",
  "homepage": "https://github.com/mysterious03/DOM_X",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mysterious03/DOM_X.git"
  },
  "bugs": {
    "url": "https://github.com/mysterious03/DOM_X/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "node build-extension.js",
    "mcp": "node dist/mcp/index.js",
    "domx": "node ./bin/dom-x.js",
    "launch": "node ./bin/dom-x.js launch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "bin": {
    "dom-x": "./bin/dom-x.js",
    "domx": "./bin/dom-x.js"
  },
  "keywords": [
    "dom-x",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-browser-agent",
    "browser-agent",
    "browser-use",
    "playwright",
    "puppeteer",
    "computer-use",
    "mutation-observer",
    "vlm-alternative",
    "chrome-extension",
    "manifest-v3",
    "semantic-dom",
    "dom-diff",
    "bounding-box",
    "web-automation"
  ],
  "author": "mysterious03",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.308",
    "@types/node": "^22.13.9",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@types/ws": "^8.18.1",
    "ws": "^8.22.0"
  }
}
